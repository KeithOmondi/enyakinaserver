# ---- Runtime ----
NODE_ENV=development            # development | test | production
PORT=4000

# ---- Database ----
DATABASE_URL=postgres://pos:<password>@localhost:5433/pos
DB_POOL_MAX=10
# Managed Postgres with a connection pooler (e.g. Neon): DATABASE_URL is the POOLED string
# (host contains "-pooler") and MIGRATE_DATABASE_URL is the DIRECT one (same, without "-pooler").
# Migrations take an advisory lock that a pooler cannot hold, so they must use the direct string.
# Leave MIGRATE_DATABASE_URL empty for a normal Postgres.
# MIGRATE_DATABASE_URL=
# Set to true when the DB requires TLS (managed Postgres). Leave false on a LAN server.
DB_SSL=false

# ---- Auth ----
# Use long random strings (at least 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m              # access tokens: short lived
JWT_REFRESH_TTL_DAYS=7          # refresh tokens: rotated on every use
BCRYPT_ROUNDS=12

# ---- HTTP ----
# Comma-separated list of front-end origins allowed by CORS (admin on 5173, shop on 5174).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of reverse proxies in front of the app (for correct client IP in rate limiting). 0 = none.
TRUST_PROXY=0
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Business rules ----
# Timezone used to define a "day" for daily reports and the daily summary job.
BUSINESS_TIMEZONE=Africa/Nairobi
# Allow one user to hold a super_admin role spanning both businesses.
ENABLE_SUPER_ADMIN=false

# Used only by docker-compose.yml (the local Postgres container); must match DATABASE_URL.
POS_DB_PASSWORD=change-me

# ---- Product photos: Cloudflare R2 (optional; all five or none) ----
# 1. Cloudflare dashboard > R2 > Create bucket.
# 2. Bucket > Settings > Public access: enable the r2.dev URL for testing, or connect a custom
#    domain for production (recommended: it is cached by Cloudflare's CDN).
# 3. R2 > Manage API tokens > Create token with "Object Read & Write", limited to this bucket.
#    Copy the Access Key ID and Secret Access Key (shown once).
# The account id is on the R2 overview page. No bucket CORS is needed: photos are uploaded
# through this API and only displayed from the public URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---- M-Pesa payment prompts (STK Push) ----
# off        typed M-Pesa codes only (default in production)
# simulator  pretends to be Safaricom, for development and demos (default in development).
#            Customer number ending 1 = cancels, 2 = no money, 3 = no answer, anything else pays.
#            Refused in production.
# daraja     real Safaricom prompts. Needs the values below.
# MPESA_MODE=simulator
#
# For daraja: register at https://developer.safaricom.co.ke, create an app, and use its keys.
# Sandbox testing: MPESA_ENV=sandbox, MPESA_SHORTCODE=174379 and the sandbox passkey from the portal.
# Going live needs your Till/Paybill and the passkey Safaricom issues for it (the "Go Live" process).
# MPESA_ENV=sandbox                    # sandbox | production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379               # the business shortcode (store/HO number for a Till)
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=till          # till = Buy Goods, paybill = Pay Bill
# MPESA_PARTY_B=                       # Till number, if different from the shortcode
# Public https address of THIS API as Safaricom can reach it (it posts the payment result there).
# While developing use a tunnel, e.g. `cloudflared tunnel --url http://localhost:8000`.
# MPESA_CALLBACK_BASE_URL=https://api.example.com
#
# One Till (or Paybill) PER BUSINESS: prefix the business code, upper case with dashes as
# underscores. The consumer key/secret above can be shared (one Daraja app); the shortcode,
# passkey and Till number belong to each business and are never borrowed from another one.
# A business with no settings of its own has prompts switched off (typed codes still work).
# MPESA_GO_FISH_TRANSACTION_TYPE=till
# MPESA_GO_FISH_SHORTCODE=             # store / head-office number
# MPESA_GO_FISH_PARTY_B=               # the Till number
# MPESA_GO_FISH_PASSKEY=
# MPESA_ENYAKIN_TRANSACTION_TYPE=till
# MPESA_ENYAKIN_SHORTCODE=
# MPESA_ENYAKIN_PARTY_B=
# MPESA_ENYAKIN_PASSKEY=
